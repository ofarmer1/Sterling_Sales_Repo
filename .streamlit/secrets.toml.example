# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is ignored by git, so these never get committed.
# On Streamlit Community Cloud, paste the same lines into the app's Secrets box.

# Password for signing in to the app. Required: the app stays locked without it.
APP_PASSWORD = "change-me"

# Supabase: Project Settings > Data API (URL) and Project Settings > API Keys.
# Use the SECRET key (starts with sb_secret_), not the publishable one.
# Keep it private: it can read and write everything in the database.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_..."

# OpenAI (for research and drafts): https://platform.openai.com/api-keys
# This needs API credits on the OpenAI platform. A ChatGPT subscription
# doesn't include API credits.
OPENAI_API_KEY = "sk-..."
# Optional: which model to use. Leave out to use the default (gpt-5.4-mini).
# OPENAI_MODEL = "gpt-5.4-mini"
# Optional: total AI spending cap in US dollars (default 25). The app stops
# starting new AI requests once its estimate reaches this.
# AI_BUDGET_USD = "25"
